<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <interface name="houdini_ai_agent" label="Houdini AI Agent" icon="MISC_python" showNetworkNavigationBar="false" help_url="">
    <script><![CDATA[
from houdini_ai_agent.ui.main_panel import create_panel


def onCreateInterface():
    pane_tab = globals().get("kwargs", {}).get("paneTab")
    if pane_tab is not None and hasattr(pane_tab, "showToolbar"):
        pane_tab.showToolbar(False)
    return create_panel()
]]></script>
    <includeInToolbarMenu menu_position="0" create_separator="true"/>
    <help><![CDATA[Houdini-native AI Agent panel.]]></help>
  </interface>
</pythonPanelDocument>
