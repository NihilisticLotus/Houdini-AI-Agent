<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <toolshelf name="houdini_ai_agent" label="Houdini AI">
    <memberTool name="houdini_ai_agent::open_panel"/>
    <memberTool name="houdini_ai_agent::status"/>
  </toolshelf>

  <tool name="houdini_ai_agent::open_panel" label="AI Agent" icon="MISC_python">
    <helpText><![CDATA[Open the Houdini AI Agent panel.]]></helpText>
    <script scriptType="python"><![CDATA[
import hou

desktop = hou.ui.curDesktop()
pane = desktop.createFloatingPaneTab(hou.paneTabType.PythonPanel)
interface = hou.pypanel.interfaceByName("houdini_ai_agent")
if interface is None:
    raise RuntimeError("Houdini AI Agent Python Panel interface was not found. Restart Houdini or reload packages.")
pane.setActiveInterface(interface)
if hasattr(pane, "setName"):
    pane.setName("Houdini AI Agent")
]]></script>
  </tool>

  <tool name="houdini_ai_agent::status" label="AI Agent Status" icon="MISC_python">
    <helpText><![CDATA[Show Houdini AI Agent package status.]]></helpText>
    <script scriptType="python"><![CDATA[
import hou

try:
    import houdini_ai_agent
    msg = "Houdini AI Agent is installed.\nVersion: " + houdini_ai_agent.__version__
except Exception as exc:
    msg = "Houdini AI Agent import failed:\n" + str(exc)

hou.ui.displayMessage(msg, title="Houdini AI Agent")
]]></script>
  </tool>
</shelfDocument>
